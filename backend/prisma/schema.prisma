generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String               @unique
  password          String
  createdAt         DateTime             @default(now())
  avatar            String?
  isBusy            Boolean             @default(false)
  role              Role                 @default(CUSTOMER)
  status            String?
  updatedAt         DateTime             @updatedAt
  designation       String?              @default("")
  rfps              RFP[]
  rfpCollaborations RFPCollaborator[]
  passwordResets    PasswordResetToken[]
}

model RFP {
  id            Int               @id @default(autoincrement())
  title         String
  description   String?
  filePath      String
  status        RFPStatus         @default(PENDING)
  userId        Int
  category    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  questions     Question[]
  user          User              @relation(fields: [userId], references: [id])
  collaborators RFPCollaborator[]
}

model Question {
  id                Int      @id @default(autoincrement())
  rfpId             Int
  questionText      String
  aiSuggestedAnswer String?
  userEditedAnswer  String?
  section           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rfp               RFP      @relation(fields: [rfpId], references: [id])
}

model RFPCollaborator {
  id          Int                @id @default(autoincrement())
  rfpId       Int
  userId      Int
  role        String?            @default("Collaborator")
  status      CollaboratorStatus @default(INVITED)
  inviteToken String?
  invitedAt   DateTime?
  acceptedAt  DateTime?
  rfp         RFP                @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rfpId, userId])
}

enum Role {
  ADMIN
  CUSTOMER
  COLLABORATOR
}

enum RFPStatus {
  PENDING
  ANALYZED
  IN_PROGRESS
  COMPLETED
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum CollaboratorStatus {
  INVITED
  ACCEPTED
  REVOKED
}
