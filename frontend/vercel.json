{
   "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/files/rfps/generated/:path*",
      "destination": "https://rfp-a4lu.onrender.com/api/uploads/rfps/generated/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
